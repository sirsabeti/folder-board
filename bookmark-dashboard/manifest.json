{
  "manifest_version": 3,
  "name": "Folder Board — Bookmark Dashboard",
  "version": "1.0.0",
  "description": "A column dashboard for your Chrome bookmarks — new tab page and toolbar popup.",
  "permissions": ["bookmarks", "favicon", "storage", "unlimitedStorage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
